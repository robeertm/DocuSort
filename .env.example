# Copy this file to .env and fill in what you need.
# 🔴 Never commit .env — it holds secrets.

# Your time zone (used for log stamps and the update schedule).
TZ=Europe/Berlin

# ── The AI key ──────────────────────────────────────────────────────────────
# You can also put it in Settings later instead of here.
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Updates ─────────────────────────────────────────────────────────────────
# Watchtower is ON by default and pulls a new image nightly at 04:00.
# Move it with a cron line (seconds minutes hours day month weekday):
# WATCHTOWER_SCHEDULE=0 30 3 * * *

# ── Reach it over Tailscale (optional) ──────────────────────────────────────
# The easy way is `./deploy/tailscale.sh tskey-auth-…` — it fills in both lines
# below and starts everything. By hand it is exactly these two:
# TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
# COMPOSE_FILE=docker-compose.yml:docker-compose.tailscale.yml

# ── Both programs together (optional) ───────────────────────────────────────
# With docker-compose.both.yml this one secret wires DocuSort and the Postwache
# to each other — no account to create, no password to copy across.
# Make one with:  openssl rand -base64 24
# PAIRING_SECRET=
